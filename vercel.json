{
  "version": 2,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/room.html",
      "destination": "/frontend/pages/room.html"
    },
    {
      "source": "/rooms.html",
      "destination": "/frontend/pages/rooms.html"
    },
    {
      "source": "/login.html",
      "destination": "/frontend/pages/login.html"
    },
    {
      "source": "/profile.html",
      "destination": "/frontend/pages/profile.html"
    },
    {
      "source": "/contact.html",
      "destination": "/frontend/pages/contact.html"
    },
    {
      "source": "/contact",
      "destination": "/frontend/pages/contact.html"
    },
    {
      "source": "/pages/(.*)",
      "destination": "/frontend/pages/$1"
    },
    {
      "source": "/css/(.*)",
      "destination": "/frontend/css/$1"
    },
    {
      "source": "/js/(.*)",
      "destination": "/frontend/js/$1"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/frontend/assets/$1"
    },
    {
      "source": "/index.html",
      "destination": "/frontend/index.html"
    },
    {
      "source": "/",
      "destination": "/frontend/index.html"
    }
  ]
}

